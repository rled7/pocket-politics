{
  "name": "pocket-politics",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pocket Politics — monorepo root (Turborepo + pnpm workspaces)",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "api": "pnpm --filter @pp/api run api",
    "demo": "pnpm --filter @pp/api run demo",
    "demo:live": "pnpm --filter @pp/api run demo:live",
    "serve": "pnpm --filter @pp/api run serve",
    "ingest": "pnpm --filter @pp/api run ingest",
    "bench": "pnpm --filter @pp/bench run bench"
  },
  "devDependencies": {
    "turbo": "2.11.10"
  }
}
